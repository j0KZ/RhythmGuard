# Required
DATABASE_URL=postgresql://rhythmguard:rhythmguard_dev@localhost:5432/rhythmguard
HMAC_SECRET=a]change_me_64_char_random_hex_string_for_signing_challenges_ok
JWT_SECRET=b]change_me_64_char_random_hex_string_for_signing_jwt_tokens_ok
SITE_KEY_SALT=change_me_32_char_random_hex

# Configuration
PORT=3100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CHALLENGES=10
RATE_LIMIT_MAX_PER_ACCOUNT=5
CHALLENGE_TTL_MS=60000
JWT_EXPIRY=300

# Enterprise (optional)
ENCRYPTION_KEY=
DECAY_CHECK_CRON=0 3 * * *
DECAY_THRESHOLD_DAYS=90

# ML
ONNX_MODEL_PATH=./models/detector.onnx
ML_CONFIDENCE_THRESHOLD=0.7
ML_ESCALATION_THRESHOLD=0.5

# Development
NODE_ENV=development
LOG_LEVEL=debug

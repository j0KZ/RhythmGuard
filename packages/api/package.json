{
  "name": "@rhythmguard/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun --watch src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "@rhythmguard/shared": "workspace:*",
    "hono": "^4.6.0",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "zod": "^3.24.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.0",
    "vitest": "^2.1.0"
  }
}
